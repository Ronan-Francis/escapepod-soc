# Copy to .env and fill in. .env is gitignored and must never be committed.

# Grafana admin password (used only on Grafana's first start).
# Generate one with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change-me

# Name for the "host" label on every log line (normally the Pi's hostname).
PI_HOSTNAME=my-pi

# Host group ID of systemd-journal, so Alloy can read the journal without root.
# Find it with: getent group systemd-journal
JOURNAL_GID=999

# Email alerts (Gmail SMTP). Send from a dedicated account, not your main one:
# a Gmail app password can also read that account's mailbox.
ALERT_EMAIL_TO=you@example.com
# SMTP_USER is a Gmail address in practice.
SMTP_USER=alerts-sender@example.com
SMTP_PASSWORD=app-password-here
